tree$tip.label <- gsub("<[0-9]+>", "", tree$tip.label)
}
return(tree)
}
# -----------------------------
# Read trees from NEXUS file
# -----------------------------
asr.trees <- read.nexus("Base_asr.tre")
num_trees <- length(asr.trees)
# -----------------------------
# Plot first tree in R window
# -----------------------------
tree1 <- clean_labels(asr.trees[[1]])
plot(tree1, main="Fungus Family 1")
nodelabels(tree1$node.label, cex=0.8)
# -----------------------------
# Save all trees to a PDF (1 tree per page)
# -----------------------------
pdf(file="cafe_trees.pdf")
for (i in 1:num_trees) {
mytree <- clean_labels(asr.trees[[i]])
plot(mytree, main=paste("Family", i))
nodelabels(mytree$node.label, cex=0.8)
}
dev.off()
# -----------------------------
# Example: Plot first 2 trees on same device (2 rows, 1 column)
# -----------------------------
if (num_trees >= 2) {
par(mfrow=c(2,1))  # 2 rows, 1 column
for (i in 1:2) {
mytree <- clean_labels(asr.trees[[i]])
plot(mytree, main=paste("Family", i))
nodelabels(mytree$node.label, cex=0.8)
}
par(mfrow=c(1,1))  # reset plotting layout
}
# ---------------------------------------------------
# Clean labels
tree1 <- asr.trees[[1]]
tree1$node.label <- gsub("_\\d+$", "", tree1$node.label)
tree1$tip.label  <- gsub("_\\d+$", "", tree1$tip.label)
# Read clade results
clade.results <- read.table("Base_clade_results.txt", header=FALSE, sep="\t")
# Add "No Change" column
total.gene.families <- length(asr.trees)
clade.results$V4 <- total.gene.families - (clade.results$V2 + clade.results$V3)
# Create pie matrix
pie.matrix <- as.matrix(apply(clade.results[,2:4], 2, function(x) x/total.gene.families))
colnames(pie.matrix) <- c("Expanded", "Contracted", "No Change")
# Match tips
m1 <- match(tree1$tip.label, clade.results$V1)
tip.matrix <- pie.matrix[m1, ]
rownames(tip.matrix) <- tree1$tip.label
# Match nodes
internal_nodes <- (Ntip(tree1)+1):(Ntip(tree1)+Nnode(tree1))
m2 <- match(tree1$node.label, clade.results$V1)
valid_nodes <- !is.na(m2)
node.matrix <- pie.matrix[m2[valid_nodes], ]
rownames(node.matrix) <- internal_nodes[valid_nodes]
# Clean tip labels for display
tree1$tip.label <- gsub("(<|>).*", "", tree1$tip.label)
# Plot tree with pies
plotTree(tree1, offset=0.5)
tiplabels(pie = tip.matrix, piecol = c("blue", "red", "green"), cex = 0.5)
nodelabels(node = as.numeric(rownames(node.matrix)),
pie = node.matrix, piecol = c("blue", "red", "green"), cex=0.5)
legend("topleft", c("Expanded", "Contracted", "No Change"),
fill=c("blue", "red", "green"), bty="n")
setwd("/Users/omarne/Documents/binf_8205_cme/exercise_3/cafe_output")
# --- Read CAFE results ---
cplot.results <- read.table("result_summary.tsv", header=TRUE, sep="\t")
# --- Filter for Family 1 ---
fam <- cplot.results[cplot.results$FamilyID == 1, ]
fam <- fam[order(fam$TaxonID), ]
# --- Create expansion/contraction matrix ---
exp <- ifelse(fam$Change > 0, 1, 0)
con <- ifelse(fam$Change < 0, 1, 0)  # contraction = Change < 0
pie.matrix <- cbind(Expansion = exp, Contraction = con)
# --- Extract the tree ---
tree_obj <- asr.trees[["1"]]
# If tree_obj is a list containing phylo, extract the first phylo element
if (is.list(tree_obj) && any(sapply(tree_obj, inherits, "phylo"))) {
tree10 <- tree_obj[[which(sapply(tree_obj, inherits, "phylo"))[1]]]
} else if (inherits(tree_obj, "phylo")) {
tree10 <- tree_obj
} else {
stop("Extracted tree is not a phylo object or a list containing a phylo tree.")
}
# --- Clean tip labels ---
tree10$tip.label <- gsub("(<|>).*", "", tree10$tip.label)
# --- Match tips to pie.matrix ---
tip.match <- match(tree10$tip.label, fam$TaxonID)
tip.matrix <- pie.matrix[tip.match, , drop = FALSE]
rownames(tip.matrix) <- tree10$tip.label
# --- Clean and match node labels ---
node.matrix <- NULL
node.size <- NULL
if (!is.null(tree10$node.label)) {
tree10$node.label <- gsub("<.*", "", tree10$node.label)
node.match <- match(tree10$node.label, fam$TaxonID)
node.match <- node.match[!is.na(node.match)]
if (length(node.match) > 0) {
node.matrix <- pie.matrix[node.match, , drop = FALSE]
rownames(node.matrix) <- (Ntip(tree10) + 1):(Ntip(tree10) + length(node.match))
}
}
# --- Set tip and node sizes ---
size <- log10(abs(fam$Change))
size[fam$Pvalue > 0.05] <- 0.1  # smaller pies for non-significant changes
tip.size <- rep(0.3, Ntip(tree10))  # base size
tip.size[!is.na(tip.match)] <- pmax(size[tip.match], 0.1)  # avoid zeros
if (!is.null(node.matrix)) {
node.size <- rep(0.3, nrow(node.matrix))
node.size <- pmax(size[node.match], 0.1)
}
# --- Plot the tree ---
if (requireNamespace("phytools", quietly = TRUE)) {
phytools::plotTree(tree10, offset = 1.25, mar = c(3, 1, 2.5, 1))
} else {
plot(tree10, show.tip.label = TRUE, cex = 0.8)
}
# --- Add tip pies ---
tiplabels(pie = tip.matrix, piecol = c("blue", "red"), cex = tip.size*0.5)
# --- Add node pies ---
if (!is.null(node.matrix)) {
nodelabels(node = as.numeric(rownames(node.matrix)), pie = node.matrix,
piecol = c("blue", "red"), cex = node.size*0.5)
}
# --- Add legend and title ---
par(xpd = TRUE)
legend("bottom", legend = c("Expansion", "Contraction"), fill = c("blue", "red"),
bty = "n", horiz = TRUE, inset = -0.1)
title(main = "Fungus Family 1")
