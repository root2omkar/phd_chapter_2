# -----------------------------
# Function to clean node and tip labels
# -----------------------------
clean_labels <- function(tree) {
if (!is.null(tree$node.label)) {
tree$node.label <- gsub("_", "", gsub("<[0-9]+>_?", "", tree$node.label))
}
if (!is.null(tree$tip.label)) {
tree$tip.label <- gsub("<[0-9]+>", "", tree$tip.label)
}
return(tree)
}
