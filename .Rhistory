small_data <- readDNAStringSet("filtered_data.fasta")
clustal <- msa(dna, method = "ClustalOmega", type = "dna")
small_data <- readDNAStringSet("filtered_data.fasta")
clustal <- msa(dna, method = "ClustalOmega", type = "dna")
small_data <- readDNAStringSet("filtered_data.fasta")
