# -----------------------------
# Save all trees to a PDF (1 tree per page)
# -----------------------------
pdf(file="cafe_trees.pdf")
for (i in 1:num_trees) {
mytree <- clean_labels(asr.trees[[i]])
plot(mytree, main=paste("Family", i))
nodelabels(mytree$node.label, cex=0.8)
}
dev.off()
# -----------------------------
# Example: Plot first 2 trees on same device (2 rows, 1 column)
# -----------------------------
if (num_trees >= 2) {
par(mfrow=c(2,1))  # 2 rows, 1 column
